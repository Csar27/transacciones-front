# ---------------------------------------------------------------------------
# Copia este archivo como ".env" y ajusta los valores si tu entorno es otro.
# ".env" esta en el .gitignore: no se versiona.
# ---------------------------------------------------------------------------

# URL base que usa axios en el navegador.
# Relativa a proposito: sale del mismo origen que el servidor de Vite y la
# resuelve el proxy de abajo. Poner aqui "http://localhost:5250" hace que la
# peticion salga del navegador y dependa de que CORS lo permita.
VITE_API_URL=/api

# A donde reenvia el proxy de Vite. Solo se usa en "npm run dev".
VITE_PROXY_TARGET=http://localhost:5250